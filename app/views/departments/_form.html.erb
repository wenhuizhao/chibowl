<%= form_for @department do |f| %>
  <%= form_errors_for @departmentg %>

  <div class="form-inputs">
    <div class= "row">
      <div class="col s12">
        <label>Name</label>
        <%= f.text_field :name %>
      </div>
    </div>
    <div class= "row">
      <div class="col s12 input-field">
        <label>Description</label>
        <%= f.text_area :desc, class: 'materialize-textarea' %>
      </div>
    </div>

  <div class="form-actions">
    <%= f.button :submit, class: 'btn' %>
  </div>
<% end %>
