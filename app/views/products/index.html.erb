<p id="notice"><%= notice %></p>

<h1>Products</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Category</th>
      <th>Chef</th>
      <th>Price</th>
      <th>Desc</th>
      <th>Featured</th>
      <th>Hot</th>
      <th colspan="3"></th>
    </tr> 
  </thead>

  <tbody>
    <%= form_tag available_day_multiple_edit_products_path, method: :get do%>
    <% @products.each do |product| %>
    <% product_id=product.id%>
    <tr>
      <td><%= product.name %></td>
      <td><%= product.category_id %></td>
      <td><%= product.chef_id %></td>
      <td><%= product.price %></td>
      <td><%= product.desc %></td>
      <td><%= product.featured %></td>
      <td><%= product.hot %></td>
      <td><%= link_to 'Show', product %></td>
      <td><%= link_to 'Edit', edit_product_path(product) %></td>
      <td><%= link_to 'Destroy', product, method: :delete, data: { confirm: 'Are you sure?' } %></td>
    </tr>
    <% end %>

  </tbody>
</table>

<br>

<%= link_to 'New Product', new_product_path %>
<br>
<%= link_to 'Multiple Edit', multiple_edit_products_path, method: :get%>
<% end %>