<%= form_for :empty_attr, url:available_day_multiple_update_products_path, method:"post" do |f|%>
    <% @products.each do |product|%>
    <%= hidden_field_tag "product_ids[]",product.id%>
    <%end%>
    <div class= "row">
      <div class="col s12">
        <label>Status</label>
        <%= f.select :status, options_for_select(Product.statuses.map {|k, v| [k.humanize.capitalize, k]}) %>
      </div>
    </div>
    <div class= "row">
      <div class="col s12">
        <label>Available date</label>
        <%= f.date_select :available_day, {order: [:year, :month, :day],prompt: { day: 'Select day', month: 'Select month'} }  %>
      </div>
    </div>
    <div class="form-actions">
    <%= f.button :submit, class: 'btn' %>
  </div>
<%end%>