<%= simple_form_for(@product) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :name %>
    <%= f.association :category %>
    <%= f.association :chef %>
    <%= f.input :price %>
    <%= f.input :featured, inline_label: 'Featured'%>
    <%= f.input :desc %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
