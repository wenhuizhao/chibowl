<%= form_for @product do |f| %>
  <%= form_errors_for @product %>

  <div class="form-inputs">
    <div class= "row">
      <div class="col s12">
        <label>Name</label>
        <%= f.text_field :name %>
      </div>
    </div>
    <div class= "row">  
      <div class="col s12 input-field">
        <%= f.collection_select :category_id, Category.all, :id, :name %>
        <label>Category</label>
      </div>
    </div>
    <div class= "row">  
      <div class="col s12 input-field">
        <%= f.collection_select :department_id, Department.all, :id, :name %>
        <label>Department</label>
      </div>
    </div>

    <div class= "row">
      <div class="col s12 input-field">
        <%= f.collection_select :chef_id, Chef.all, :id, :name %>
        <label>Chef</label>
      </div>
    </div>
    <div class= "row">
      <div class="col s12">
        <label>Price</label>
        <%= f.text_field :price %>
      </div>
    </div>
    <div class= "row">
      <div class="col s12">
        <label>Sell Price</label>
        <%= f.text_field :sell_price %>
      </div>
    </div>
    <div class= "row">
      <div class="col s12">
        <label>Rating</label>
        <%= f.collection_select :rating, 1..5, :to_f, :to_s %>
      </div>
    </div>

    <div class= "row">
      <div class="col s12">
        <label>Featured</label>
        <div class="switch">
          <label>
            <%=f.check_box :featured %>
            <span class="level"></span>
          </label>
        </div>
      </div>
    </div>
    <div class= "row">
      <div class="col s12">
        <label>Hot</label>
        <div class="switch">
          <label>
            <%=f.check_box :hot %>
            <span class="level"></span>
          </label>
        </div>
      </div>
    </div>
    <div class= "row">
      <div class="col s12 input-field">
        <label>Description</label>
        <%= f.text_area :desc, class: 'materialize-textarea' %>
      </div>
    </div>
    <div class= "row">
      <div class="col s12 input-field">
        <label>Extra</label>
        <%= f.text_area :extra, class: 'materialize-textarea' %>
      </div>
    </div>

    <div class= "row">
      <div class="col s12">
        <label>Status</label>
        <%= f.select :status, options_for_select(Product.statuses.map {|k, v| [k.humanize.capitalize, k]}) %>
      </div>
    </div>
    <!--<div class= "row">
      <div class="col s12">
        <label>Available date</label>
        <%= f.date_select :available_day, {order: [:month, :day],prompt: { day: 'Select day', month: 'Select month'} }, use_short_month:true %>
      </div>
    </div>-->
    <div class= "row">
       <div class="col s12">
         <label>Photos</label>
         <%= f.file_field :files, multiple: true %>
       </div>
    </div> 
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: 'btn' %>
  </div>
<% end %>
