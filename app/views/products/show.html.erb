<p id="notice"><%= notice %></p>

<p>
  <strong>Name:</strong>
  <%= @product.name %>
</p>

<p>
  <strong>Category:</strong>
  <%= @product.category_id %>
</p>
<% if @product.featured %>
<p>
  <strong>Featured</strong>
</p>
<% end %>

<p>
  <strong>Chef:</strong>
  <%= @product.chef_id %>
</p>

<p>
  <strong>Price:</strong>
  <%= @product.price %>
</p>

<p>
  <strong>Desc:</strong>
  <%= @product.desc %>
</p>

<%= link_to 'Edit', edit_product_path(@product) %> |
<%= link_to 'Back', products_path %>
