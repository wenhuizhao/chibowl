<p id="notice"><%= notice %></p>

<h1>Products multiple edit</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Available day</th>
      <th>Edit available day</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <%= form_tag available_day_multiple_edit_products_path, method: :get do%>
    <% @products&.each do |product| %>
    <% product_id=product.id%>
    <tr>
      <td><%= product.name %></td>
      <td><%= product.available_day %></td>
      <td><%= label_tag  do%>
        <%= check_box_tag "product_ids[]", product_id, checked = false, class:"mdl-checkbox__input"%>
        <span class="mdl-checkbox__label"></span>
        <%end%>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>

<br>
<!--<%= submit_tag 'edit available day', class: 'btn' %>-->
<input class="btn" value="edit available day" type="submit" />
<% end %>