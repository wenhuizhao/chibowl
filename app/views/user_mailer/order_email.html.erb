
<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body>
    <p><%=t 'mail.order.title_1'%><%=@order.first_name%> <%=@order.last_name%><%= t 'mail.order.title_2'%></p>
    <p>
      <%=t 'mail.order.content' %>: </p>
     <h3>
      <%= link_to t('mail.order.subject'), @url%>
    </h3>
    <p>
      <%=t 'mail.order.ending'%>
    </p>
    <p>
      <%=t 'mail.order.wish' %>
    </p>
    <p><%=t 'mail.order.sign'%></p>
    <p><%=t 'mail.order.sign_2'%></p>
    <%= image_tag(attachments['public_account.jpg'].url)%>
  </body>
</html>
