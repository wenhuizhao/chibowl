    <ul class="modal-profile-ul">
      <li><%=link_to t('modal.profile.my_orders'), home_profile_path %></li>
      <li><a href="javascript:void(0);" onClick="viewCart()" class="mdl-navigation__link">
                <%= t 'header.cart'%>
            </a>
      </li>
      <li><%=link_to t('modal.profile.account_info') %></li>
      <li><%= link_to (t 'modal.profile.logout'), destroy_user_session_url, data: {method: :delete} %></li>
    </ul>
    </div>

    <%# <div class="modal-footer">

