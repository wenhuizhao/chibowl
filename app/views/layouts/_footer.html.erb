<footer class="mdl-mega-footer oxy-color-primary">
    <div class="mdl-mega-footer--middle-section">
        <div class="mdl-mega-footer--drop-down-section">
            <input class="mdl-mega-footer--heading-checkbox" type="checkbox" checked>
            <h1 class="mdl-mega-footer--heading"><%= t 'footer.about' %></h1>
            <div class="mdl-mega-footer__widget">
                <p>
                    <%= t 'footer.about_1' %>
                </p>
                <p>
                    <%= t 'footer.about_2' %>
                </p>
            </div>
            <div class="mdl-mega-footer__widget">
                <i class="fa fa-cc-mastercard"></i>
                &nbsp;
                <i class="fa fa-cc-visa"></i>
                &nbsp;
                <i class="fa fa-cc-amex"></i>
                &nbsp;
                <i class="fa fa-cc-paypal"></i>
                &nbsp;
            </div>
        </div>

        <div class="mdl-mega-footer--drop-down-section">
            <input class="mdl-mega-footer--heading-checkbox" type="checkbox" checked>
            <h1 class="mdl-mega-footer--heading"><%= t 'footer.contact_us' %></h1>
            <div class="mdl-mega-footer__widget">
                <p>
                   <%= t 'footer.contact_us_title' %> 
                </p>
                <p>
                    <%= t 'footer.contact_us_address' %>
                </p>
                <p>
                    <a href="#">chibowl.com</a>
                    <br>
                    info@chibowl.com
                </p>
                <p>
                    <a href="#" class="mdl-button mdl-js-button mdl-button--icon">
                        <i class="fa fa-facebook"></i>
                    </a>
                    <a href="#" class="mdl-button mdl-js-button mdl-button--icon">
                        <i class="fa fa-twitter" ></i>
                    </a>
                    <a href="#" class="mdl-button mdl-js-button mdl-button--icon">
                        <i class="fa fa-flickr" ></i>
                    </a>
                    <a href="#" class="mdl-button mdl-js-button mdl-button--icon">
                        <i class="fa fa-linkedin" ></i>
                    </a>
                </p>
            </div>
        </div>
    </div>

    <div class="mdl-mega-footer--bottom-section">
        <div class="mdl-logo">Chibowl</div>
        <ul class="mdl-mega-footer--link-list">
            <li><a href="#"><%= t 'footer.faq'%></a></li>
            <li><a href="#"><%= t 'footer.privacy'%></a></li>
            <li><a href="#"><%= t 'footer.term'%></a></li>
        </ul>
    </div>
</footer>