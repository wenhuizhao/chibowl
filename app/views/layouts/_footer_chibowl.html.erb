<footer class="mdl-mega-footer oxy-color-primary">
    <div class="mdl-mega-footer--middle-section">
        <div class="mdl-mega-footer--drop-down-section">
            <input class="mdl-mega-footer--heading-checkbox" type="checkbox" checked>
            <h1 class="mdl-mega-footer--heading"><%= t 'footer.about' %></h1>
            <div class="mdl-mega-footer__widget">
                <p>
                    <%= t 'footer.contact_us' %>
                </p>
                <p>
                    <%= t 'footer.follow_us' %>
                </p>
            </div>
            <div class="mdl-mega-footer__widget">
                <i class="fa fa-weixin fa-lg"></i>
                &nbsp;
                <i class="fa fa-youtube fa-lg"></i>
                &nbsp;
                <i class="fa fa-facebook-square fa-lg"></i>
                &nbsp;
            </div>
        </div>

        <div class="mdl-mega-footer--drop-down-section">
            <input class="mdl-mega-footer--heading-checkbox" type="checkbox" checked>
            <h1 class="mdl-mega-footer--heading"><%= t 'footer.join_us' %></h1>
            <div class="mdl-mega-footer__widget">
                <p>
                   <%= t 'footer.collaboration' %> 
                </p>
                <p>
                    support@chibowl.com
                </p>
            </div>
            <div class="mdl-mega-footer__widget">
                <i class="fa fa-cc-visa fa-lg"></i>
                &nbsp;
                <i class="fa fa-cc-discover fa-lg"></i>
                &nbsp;
                <i class="fa fa-cc-stripe fa-lg"></i>
                &nbsp;
                <i class="fa fa-cc-paypal fa-lg"></i>
                &nbsp;
            </div>
        </div>

        <div class="mdl-mega-footer--drop-down-section">
            <input class="mdl-mega-footer--heading-checkbox" type="checkbox" checked>
            <%= image_tag "public_account.jpg", alt:"ChiBowl", size:"200x200" %>
            <div class="mdl-mega-footer__widget">
                <h1 class="mdl-mega-footer--heading"><%= t 'footer.follow_wechat' %></h1>
                <p>
                   <%= t 'footer.more_products' %> 
                </p>
            </div>
    </div>

    <div class="mdl-mega-footer--bottom-section">
        <div class="mdl-logo">Chibowl</div>
        <ul class="mdl-mega-footer--link-list">
            <li><%= link_to t('footer.privacy'), home_privacy_path %></li>
            <li><%= link_to t('footer.term'), home_user_term_path %></li>
        </ul>
        <p>@Copyright  2019 - 2022 CHIBOWL.com, All rights reservd.</p>
    </div>
</footer>