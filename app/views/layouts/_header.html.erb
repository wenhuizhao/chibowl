<header class="mdl-layout__header mdl-layout__header--scroll">
    <!-- Top row, always visible -->
    <div class="mdl-layout__header-row">
        <!-- Title -->
        <!--<%= link_to root_path, class:"mdl-layout-title" do %>
            <%= image_tag "chibowl.png", alt:"ChiBowl", size:"52x54" %>
        <% end %>-->
        <a class="mdl-layout-title" href="javascript:void(0);" onClick="homePage()"><%= image_tag "chibowl.png", alt:"ChiBowl", size:"52x54" %></a>
        <div class="mdl-layout-spacer"></div>
        <nav class="mdl-navigation mdl-layout--large-screen-only">
            <a class="mdl-navigation__link" href="javascript:void(0);" onClick="homeToday()"><%= t 'header.today' %></a>
            <a class="mdl-navigation__link" href="javascript:void(0);" onClick="becomeChef()"><%= t 'header.chef' %></a>
            <!--<%= link_to t('header.today'), root_path(:anchor=> "daily_products"), class: "mdl-navigation__link"%>-->
            <!--<%= link_to t('header.chef'), chefs_path, class: "mdl-navigation__link" %>-->
            <!--<%= link_to t('header.chef'), become_chefs_path, class: "mdl-navigation__link"%>-->
            <a href="javascript:void(0);" onClick="viewCart()" class="mdl-navigation__link">
                <%= t 'header.cart'%>
            </a>
            <a href="javascript:void(0);" onClick="viewCheckout()" class="mdl-navigation__link">
                <%= t 'header.checkout'%>
            </a>
            <!--<a class="mdl-navigation__link" href="/cms"><%= t 'header.news' %></a>-->
            <!--<%= link_to t('header.cart'), cart_orders_path, class:"mdl-navigation__link" %>
            <%= link_to t('header.checkout'), checkout_orders_path,  class:"mdl-navigation__link" %>-->
        <ul class="nav-right">
            <%# <li><a>中文</a>
                <a>English</a>
            </li> %>
        <% if user_signed_in? %>
            <li><%= link_to (t 'header.logout'), destroy_user_session_url, data: {method: :delete} %></li>
        <% else %>
            <li>
            <%= link_to (t 'header.login'), new_user_session_url, class: 'mdl-navigation__link' %>
            </li>
        <% end %>
        </ul>

        </nav>
        <div class="mdl-textfield mdl-js-textfield mdl-textfield--expandable mdl-textfield--floating-label mdl-textfield--align-right">
            <label class="mdl-button mdl-js-button mdl-button--icon" for="waterfall-exp">
                <i class="material-icons">search</i>
            </label>
            <div class="mdl-textfield__expandable-holder">
                <input class="mdl-textfield__input" type="text" name="sample" id="waterfall-exp" /> </div>
        </div>
    </div>
</header>
