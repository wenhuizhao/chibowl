            <%= image_tag "chibowl.png", alt:"ChiBowl", size:"52x54" %>
    <% end %>-->
    <nav class="mdl-navigation">
        <!--<nav class="mdl-navigation mdl-navigation__submenu">
            <a class="mdl-navigation__link mdl-navigation__submenu__link" href="index.html"><%= t 'header.home' %></a>
        </nav>-->
        <%= link_to t('header.today'), root_path(:anchor=> "daily_products"), class: "mdl-navigation__link"%>
        <!--<nav class="mdl-navigation mdl-navigation__submenu">
            <a class="mdl-navigation__link mdl-navigation__submenu__link" href="shop.html"><%= t 'header.chef.featured' %></a>
        </nav>-->
