<div class="mdl-layout__drawer">
    <a class="mdl-layout-title" href="index.html">
        <%= image_tag "logo-dark.png", alt:"FAB!" %>
    </a>
    <nav class="mdl-navigation">
        <a class="mdl-navigation__link mdl-navigation__link--submenu" href="#"><%= t 'header.home' %></a>
        <nav class="mdl-navigation mdl-navigation__submenu">
            <a class="mdl-navigation__link mdl-navigation__submenu__link" href="index.html"><%= t 'header.home' %></a>
        </nav>
        <a class="mdl-navigation__link mdl-navigation__link--submenu" href="#"><%= t 'header.chef' %></a>
        <nav class="mdl-navigation mdl-navigation__submenu">
            <a class="mdl-navigation__link mdl-navigation__submenu__link" href="shop.html"><%= t 'header.chef.featured' %></a>
        </nav>
        <span class="mdl-navigation__link-divider"></span>

        <a class="mdl-navigation__link" href="customizer.html">
            <i class="material-icons mdl-navigation__icon">build</i>
            Customizer
        </a>
        <a class="mdl-navigation__link" href="cart.html">
            <i class="material-icons mdl-navigation__icon">shopping_basket</i>
            Cart
        </a>
        <a class="mdl-navigation__link" href="checkout.html">
            <i class="material-icons mdl-navigation__icon">credit_card</i>
            Checkout
        </a>
        <% if user_signed_in? %>
            <%= link_to (t 'header.logout'), destroy_user_session_url, data: {method: :delete} %>
        <% else %>
            <%= link_to (t 'header.login'), new_user_session_url, class: 'mdl-navigation__link' %>
        <% end %>
    </nav>
</div>