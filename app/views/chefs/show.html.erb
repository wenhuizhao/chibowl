<div class="container">
<p id="notice"><%= notice %></p>

<p>
  <strong>Name:</strong>
  <%= @chef.name %>
</p>

<p>
  <strong>Desc:</strong>
  <%= @chef.desc %>
</p>
<p>
  <strong>Featured</strong>
  <%= @chef.featured%>
</p>
<p>
  <strong>Street:</strong>
  <%= @chef.street %>
</p>

<p>
  <strong>City:</strong>
  <%= @chef.city %>
</p>

<p>
  <strong>State:</strong>
  <%= @chef.state %>
</p>

<p>
  <strong>Country:</strong>
  <%= @chef.country %>
</p>

<p>
  <strong>Zip:</strong>
  <%= @chef.zip %>
</p>

<p>
  <strong>User:</strong>
  <%= @chef.user.email %>
<p>
  <strong>Latitude:</strong>
  <%= @chef.latitude %>
</p>

<p>
  <strong>Longitude:</strong>
  <%= @chef.longitude %>
</p>
<p>
  <strong>SSN:</strong>
  <%= @chef.ssn %>
</p>
<div>
  <p><strong>Images:</strong></p>
  <% @chef.photos.each do |photo| %>
    <%=image_tag photo.image.url(:small) %>
  <% end %>
</div>
<%= link_to 'Edit', edit_chef_path(@chef) %> |
<%= link_to 'Back', chefs_path %>
</div>