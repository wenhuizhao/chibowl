<%= form_for(@chef) do |f| %>
  <%= form_errors_for @product %>

  <div class="form-inputs">
    <div class= "row">
      <div class="col s12">
        <label>Name</label>
        <%= f.text_field :name %>
      </div>
    </div>
    <div class= "row">
      <div class="col s12 input-field">
        <label>Description</label>
        <%= f.text_area :desc, class: 'materialize-textarea' %>
      </div>
    </div>
    <div class= "row">
      <div class="col s12">
        <label>Featured</label>
        <div class="switch">
          <label>
            <%=f.check_box :featured %>
            <span class="level"></span>
          </label>
        </div>
      </div>
    </div>
    <div class= "row">
      <div class="col s12">
        <label>Street</label>
        <%= f.text_field :street %>
      </div>
    </div>
    <div class= "row">
      <div class="col s12">
        <label>City</label>
        <%= f.text_field :city %>
      </div>
    </div>
    <div class= "row">
      <div class="col s12">
        <label>State</label>
        <%= f.text_field :state %>
      </div>
    </div>

    <%= f.hidden_field :country, value: 'US' %>
    <div class= "row">
      <div class="col s12">
        <label>Zip</label>
        <%= f.text_field :zip %>
      </div>
    </div>

    <div class= "row">
      <div class="col s12">
        <label>Photos</label>
        <%= f.file_field :files, multiple: true %>
      </div>
    </div>
    <div class= "row">
      <div class="col s12">
        <label>SSN</label>
        <%= f.text_field :ssn %>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: 'btn' %>
  </div>

<% end %>
