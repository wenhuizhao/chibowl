<p>get form</p>
<div class="mdl-grid">
<div class="mdl-cell mdl-cell--6-col">
<%= form_tag(yuansfer_callback_path, method: 'get') do %>
<div class="mdl-textfield mdl-js-textfield mdl-textfield--full-width mdl-textfield--floating-label">
    <textarea class="mdl-textfield__input" name="yuansferId" type="text" rows="4" id="yuansferId"></textarea>
    <label class="mdl-textfield__label" for="yuansferId">yuansferId</label>
</div>
<div class="mdl-textfield mdl-js-textfield mdl-textfield--full-width mdl-textfield--floating-label">
    <textarea class="mdl-textfield__input" name="status" type="text" rows="4" id="status"></textarea>
    <label class="mdl-textfield__label" for="status">status</label>
</div>
<div class="mdl-textfield mdl-js-textfield mdl-textfield--full-width mdl-textfield--floating-label">
    <textarea class="mdl-textfield__input" name="amount" type="text" rows="4" id="amount"></textarea>
    <label class="mdl-textfield__label" for="amount">amount</label>
</div>
<div class="mdl-textfield mdl-js-textfield mdl-textfield--full-width mdl-textfield--floating-label">
    <textarea class="mdl-textfield__input" name="time" type="text" rows="4" id="time"></textarea>
    <label class="mdl-textfield__label" for="time">time</label>
</div><div class="mdl-textfield mdl-js-textfield mdl-textfield--full-width mdl-textfield--floating-label">
    <textarea class="mdl-textfield__input" name="reference" type="text" rows="4" id="reference"></textarea>
    <label class="mdl-textfield__label" for="reference">reference</label>
</div><div class="mdl-textfield mdl-js-textfield mdl-textfield--full-width mdl-textfield--floating-label">
    <textarea class="mdl-textfield__input" name="note" type="text" rows="4" id="note"></textarea>
    <label class="mdl-textfield__label" for="note">note</label>
</div><div class="mdl-textfield mdl-js-textfield mdl-textfield--full-width mdl-textfield--floating-label">
    <textarea class="mdl-textfield__input" name="verifySign" type="text" rows="4" id="verifySign"></textarea>
    <label class="mdl-textfield__label" for="verifySign">verifySign</label>
</div>
<button class="mdl-button mdl-js-button mdl-button--raised mdl-button--colored"> submit </button>
<% end %>
</div>
</div>