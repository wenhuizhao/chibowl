%h1 Listing sub_orders

%table
  %thead
    %tr
      %th
      %th
      %th

  %tbody
    - @sub_orders.each do |sub_order|
      %tr
        %td= link_to 'Show', sub_order
        %td= link_to 'Edit', edit_sub_order_path(sub_order)
        %td= link_to 'Destroy', sub_order, method: :delete, data: { confirm: 'Are you sure?' }

%br

= link_to 'New Sub order', new_sub_order_path
