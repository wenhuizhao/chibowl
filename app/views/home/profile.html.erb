<div class=“oxy-section oxy-color-primary”>
    <div class=“oxy-section__content”>
        <div class="mdl-grid mdl-grid--no-fullwidth oxy-margin-top-40 ">
            <div class="mdl-cell mdl-cell--12-col mdl-cell--8-col-tablet mdl-cell--4-col-phone">
                <div class="horizontal_center"><%= image_tag @user.avatar.url, alt:"my avatar"%></div>
                <div class="mdl-typography--subhead horizontal_center"><%= @user.email%></div>
                <div class="horizontal_center"><%= link_to become_chefs_path do %>
                    <button class="mdl-button mdl-js-button mdl-js-ripple-effect mdl-button--accent mdl-button--raised">
                        <%= t 'header.chef'%> </button>
                    <% end%>
                </div>
                <!-- <div class="horizontal_center"><%= link_to destroy_user_session_url, data: {method: :delete} do%>
                 <button class="mdl-button mdl-js-button mdl-js-ripple-effect mdl-button--accent mdl-button--raised">
                    <%= t 'header.logout'%> </button>
                    <% end%>
                </div> -->
            </div>
        </div>
    </div>
</div>
<div class=“oxy-section oxy-color-primary”>
    <div class=“oxy-section__content”>
        <div class="mdl-grid mdl-grid--no-fullwidth">
            <div class="mdl-cell mdl-cell--12-col mdl-cell--8-col-tablet mdl-cell--4-col-phone">
                <div class="divider"></div>
            </div>
        </div>
    </div>
</div>
<div class=“oxy-section oxy-color-primary”>
    <div class=“oxy-section__content”>
        <div class="mdl-grid mdl-grid--no-fullwidth">
            <div class="mdl-cell mdl-cell--12-col mdl-cell--8-col-tablet mdl-cell--4-col-phone">
                <div class="mdl-typography--headline"><%= t '.my_order'%>:</div>
            </div>
            <div class="mdl-typography--subhead">
                <% @user.orders.select{|order| order.status=="pending"}.each do |order|%>
                <div class="mdl-cell mdl-cell--12-col mdl-cell--8-col-tablet mdl-cell--4-col-phone oxy-margin-top-20">
                    <div class="mdl-typography--title">
                        <%= t '.order_date'%>:<%= I18n.localize(order.order_date, format: '%Y-%m-%d')%></div>
                        <div class="mdl-typography--title"><%= t'orders.show.order_total'%>:<%=order.total_with_unit%></div>
                    <ol style="list-style-type:disc;">
                        <% order.pickup_date_restaunt.each do |day, products_hash| %>
                        <li>
                            <div class="mdl-cell mdl-cell--12-col mdl-cell--8-col-tablet mdl-cell--4-col-phone oxy-margin-top-20">
                                <div class="mdl-typography--title"><%= t 'orders.details.pick_up_date'%>:
                                    <%= I18n.localize(day, format: '%Y-%m-%d')%></div>
                                <div class="mdl-typography--title"><%= t 'orders.details.pick_up_time'%></div>
                                <div class="mdl-typography--title"><%= t 'orders.checkout.picking_up_address'%></div>
                                <div class="mdl-typography--title"><%= t 'orders.details.order_product'%>:</div>
                                <% products_hash.each do |chef_id, val| %>
                                <div class="mdl-typography--title"><%= val[:name] %>: </div>
                                <% val[:products].each do |product|%>
                                <div class="mdl-typography--title mdl-typography--font-light">
                                    <%= product%><%= t 'orders.details.piece'%></div>
                                  <%end%>
                                <% end %>
                            </div>
                        </li>
                        <% end %>
              
                    </ol>
                </div>
                <div class="mdl-cell mdl-cell--12-col mdl-cell--8-col-tablet mdl-cell--4-col-phone">
                    <div class = "divider"></div>
                </div>
                <%end%>
                
            </div>

        </div>
    </div>
</div>
<div class=“oxy-section oxy-color-primary”>
    <div class=“oxy-section__content”>
        <div class="mdl-grid mdl-grid--no-fullwidth">
            <div class="mdl-cell mdl-cell--12-col mdl-cell--8-col-tablet mdl-cell--4-col-phone">
                <div class="divider"></div>
            </div>
        </div>
    </div>
</div>
<div class=“oxy-section oxy-color-primary”>
    <div class=“oxy-section__content”>
        <div class="mdl-grid mdl-grid--no-fullwidth">
            <div class="mdl-cell mdl-cell--12-col mdl-cell--8-col-tablet mdl-cell--4-col-phone">
                <div class="mdl-typography--title"><%= t '.hot_products'%>:</div>
            </div>
            <% @hot_products.each do |product| %>
            <div class="mdl-cell mdl-cell--4-col mdl-cell--4-col-tablet mdl-cell--4-col-phone"
                data-os-animation="fadeIn" data-os-animation-delay="0.1s">
                <!-- new card -->
                <%= render 'shared/card', product: product %>
            </div>
            <% end %>
        </div>

    </div>
</div>