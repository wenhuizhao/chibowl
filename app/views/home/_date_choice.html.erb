<div class="oxy-section">
    <div class="oxy-section__content">
        <div style="">
            <ul id="date_list">
                <li>
                    <div>
                        <span id="date-choice-month">
                            <%=I18n.localize(Date.today+1.days, format: '%b')%>
                        </span>
                    </div>
                </li>
                <li id="first_day">
                    <%=link_to fetch_products_path(:product_date=>Date.today+1.days), :remote=>true do %>
                        <%= render 'home/date', date: Date.today+1.days%>
                    <%end%>
                </li>
                <li><%=link_to fetch_products_path(:product_date=>Date.today+2.days), :remote=>true do %>
                        <%= render 'home/date', date: Date.today+2.days%>
                    <%end%>
                </li>
                <li><%=link_to fetch_products_path(:product_date=>Date.today+3.days), :remote=>true do %>
                        <%= render 'home/date', date: Date.today+3.days%>
                    <%end%>
                </li>
                <li><%=link_to fetch_products_path(:product_date=>Date.today+4.days), :remote=>true do %>
                        <%= render 'home/date', date: Date.today+4.days%>
                    <%end%>
                </li>
                <li><%=link_to fetch_products_path(:product_date=>Date.today+5.days), :remote=>true do %>
                        <%= render 'home/date', date: Date.today+5.days%>
                    <%end%>
                </li>
                <li><%=link_to fetch_products_path(:product_date=>Date.today+6.days), :remote=>true do %>
                        <%= render 'home/date', date: Date.today+6.days%>
                    <%end%>
                </li>
                <li><%=link_to fetch_products_path(:product_date=>Date.today+7.days), :remote=>true do %>
                        <%= render 'home/date', date: Date.today+7.days%>
                    <%end%>
                </li>
            </ul>
        </div>
    </div>
</div>
<script>
    $(document).ready(function(){
        $('#date_list li a').on('click', function() {
            $('#date_list li a').removeClass('selected-date');
            $(this).addClass('selected-date');
        });
        $('#first_day a').addClass('selected-date');
    });
</script>