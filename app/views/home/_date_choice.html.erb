<div class="oxy-section">
    <div class="oxy-section__content">
        <div class="mdl-grid mdl-grid--no-fullwidth">
            <div class="mdl-cell mdl-cell--12-col" data-os-animation="fadeIn" data-os-animation-delay="0.1s">
                <ul>
                <li><%=link_to (Time.now+1.days).strftime('%Y-%m-%d'), fetch_products_path(:product_date=>Date.today+1.days), :remote=>true %></li>
                <li><%=link_to (Time.now+2.days).strftime('%Y-%m-%d'), fetch_products_path(:product_date=>Date.today+2.days), :remote=>true %></li>
                <li><%=link_to (Time.now+3.days).strftime('%Y-%m-%d'), fetch_products_path(:product_date=>Date.today+3.days), :remote=>true %></li>
                <li><%=link_to (Time.now+4.days).strftime('%Y-%m-%d'), fetch_products_path(:product_date=>Date.today+4.days), :remote=>true %></li>
                <li><%=link_to (Time.now+5.days).strftime('%Y-%m-%d'), fetch_products_path(:product_date=>Date.today+5.days), :remote=>true %></li>
                <li><%=link_to (Time.now+6.days).strftime('%Y-%m-%d'), fetch_products_path(:product_date=>Date.today+6.days), :remote=>true %></li>
                <li><%=link_to (Time.now+7.days).strftime('%Y-%m-%d'), fetch_products_path(:product_date=>Date.today+7.days), :remote=>true %></li>
            </ul>
            </div>
        </div>
    </div>
</div>
