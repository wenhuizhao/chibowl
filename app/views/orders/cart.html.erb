<div class="oxy-section">
  <%# <div class="oxy-section__background oxy-background-parallax">
      <img src="assets/images/backgrounds/bg24-notinclude.jpg" alt="section background"> </div> %>
  <div class="oxy-section__overlay oxy-section__overlay--gradient-from-top-30"></div>
  <div class="oxy-section__content">
      <div class="mdl-grid mdl-grid--no-fullwidth">
          <h1 class="oxy-color-light mdl-typography--display-1 mdl-typography--font-thin "><%=t '.cart_title'%></h1>
      </div>
  </div>
</div>
<div class="oxy-section">
  <div class="oxy-section__content">
      <div class="mdl-grid mdl-grid--no-fullwidth oxy-margin-top-40 ">
          <div class="mdl-cell mdl-cell--12-col mdl-cell--8-col-tablet mdl-cell--4-col-phone mdl-cell--middle">
              <table class="mdl-data-table mdl-js-data-table mdl-shadow--2dp oxy-full-width oxy-data-table oxy-data-table--center oxy-data-table--middle">
                  <thead>
                      <tr>
                          <th> </th>
                          <th> </th>
                          <th><%= t '.product'%></th>
                          <th><%= t '.price'%></th>
                          <th><%= t '.quantity'%></th>
                          <th><%= t '.total'%></th>
                      </tr>
                  </thead>
                  <tbody id="cart-tbody">
                    <% @order.order_items.each do |item| %>
                      <tr id="tr-product-<%=item.product_id%>">
                        <td>
                            <a href="javascript:void(0);" onClick="removeProduct(<%=item.product_id%>)"
                              title="Remove this item" class="mdl-button mdl-js-button mdl-button--accent mdl-button--icon">
                              <i class="material-icons">close</i>
                            </a>
                        </td>
                        <td>
                          <a href="#">
                              <img width="60" height="60" src="<%=item.product.photo1_url_medium%>" alt="image"> </a>
                        </td>
                        <td>
                          <a href="#"><%=item.product.name%></a>
                        </td>
                        <td> <%=item.product.price.round(2)%> </td>
                        <td>
                          <div class="oxy-quantity">
                              <input type="button" value="-" onClick="minusQuantity(<%=item.product.id%>)">
                              <div class="mdl-textfield mdl-js-textfield">
                                  <input type="number" step="1" min="0" name="cart" value="<%=item.quantity%>"
                                title="Qty" class="mdl-textfield__input" id="quantity-<%=item.product.id%>">
                                  <label class="mdl-textfield__label" for="q1"></label>
                              </div>
                              <input type="button" value="+" onClick="plusQuantity(<%=item.product.id%>)"> </div>
                        </td>
                        <td id="total">
                          <strong><%=item.subtotal.round(2)%></strong>
                        </td>
                      </tr>
                    <% end %>

                  </tbody>
              </table>
          </div>
      </div>
      <div class="mdl-grid mdl-grid--no-fullwidth oxy-margin-bottom-20">
          <!--<div class="mdl-cell mdl-cell--3-col mdl-cell--8-col-tablet mdl-cell--8-col-phone mdl-cell--middle">
              <div class="mdl-textfield mdl-js-textfield mdl-textfield--full-width">
                  <input class="mdl-textfield__input" type="text" id="coupon" />
                  <label class="mdl-textfield__label" for="coupon">Coupon Code</label>
              </div>
          </div>
          <div class="mdl-cell mdl-cell--2-col mdl-cell--8-col-tablet mdl-cell--8-col-phone mdl-cell--middle">
              <button class="mdl-button mdl-js-button mdl-button--raised mdl-js-ripple-effect
                mdl-button--accent oxy-full-width"> <%=t '.apply_coupon'%> </button>
          </div>
          <div class="mdl-cell mdl-cell--3-col mdl-cell--8-col-tablet mdl-cell--8-col-phone mdl-cell--middle"> </div>
          <div class="mdl-cell mdl-cell--2-col mdl-cell--4-col-tablet mdl-cell--4-col-phone mdl-cell--middle">-->
              <!-- Accent-colored raised button with ripple -->
              <!--<button class="mdl-button mdl-js-button mdl-button--raised mdl-js-ripple-effect 
                mdl-button--accent oxy-full-width" onClick="viewCart()"> <%= t '.update_cart'%> </button>
          </div>-->
          <div class="mdl-cell mdl-cell--10-col mdl-cell--6-col-tablet mdl-cell--3-col-phone mdl-cell--middle"></div>
          <div class="mdl-cell mdl-cell--2-col mdl-cell--2-col-tablet mdl-cell--1-col-phone mdl-cell--middle">
              <!-- Accent-colored raised button with ripple -->
              <button class="mdl-button mdl-js-button mdl-button--raised mdl-js-ripple-effect
                mdl-button--primary oxy-full-width" onClick="viewCheckout()"> <%= t '.checkout'%> </button>
          </div>
      </div>
      <div class="mdl-grid mdl-grid--no-fullwidth oxy-margin-bottom-40">
          <div class="mdl-cell mdl-cell--8-col mdl-cell--8-col-tablet mdl-cell--8-col-phone mdl-cell--middle"> </div>
          <div class="mdl-cell mdl-cell--4-col mdl-cell--8-col-tablet mdl-cell--8-col-phone mdl-cell--middle">
              <table class="mdl-data-table mdl-js-data-table mdl-shadow--2dp oxy-full-width oxy-data-table oxy-data-table--center oxy-data-table--middle">
                  <thead>
                      <tr>
                          <th colspan=2> <%= t 'cart.total' %> </th>
                      </tr>
                      <tbody>
                          <tr>
                              <td class="mdl-data-table__cell--non-numeric"><%= t 'cart.subtotal' %></td>
                              <td id="cart-subtotal"><%=@order.subtotal%></td>
                          </tr>
                          <tr>
                              <td class="mdl-data-table__cell--non-numeric"><%= t 'cart.shipping' %> </td>
                              <td id="cart-shipping"><%=@order.shipping%></td>
                          </tr>
                          <tr>
                              <td class="mdl-data-table__cell--non-numeric">
                                  <strong><%= t 'cart.total' %></strong>
                              </td>
                              <td>
                                  <strong id="cart-total"><%=@order.total%></strong>
                              </td>
                          </tr>
                      </tbody>
              </table>
          </div>
      </div>
  </div>
</div>
<script>
  function removeProduct(productId) {
    $('#tr-product-'+productId).remove();
    removeFromCart(productId);
    viewCart();
  }
  function plusQuantity(productId){
    var quantity = parseInt($('#quantity-'+productId).val())+1;
    $('#quantity-'+productId).val(quantity);
    updateProductQuantity(productId, quantity);
    viewCart();
  }
  function minusQuantity(productId){
    var quantity = parseInt($('#quantity-'+productId).val())-1;
    if (quantity < 0) {
      return;
    }
    $('#quantity-'+productId).val(quantity);    
    updateProductQuantity(productId, quantity);
    viewCart();
}
</script>
